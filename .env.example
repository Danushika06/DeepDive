# ----------------------------------------------------------------------------
# DeepDive configuration. Copy to `.env` and fill in your key(s).
#   cp .env.example .env   (Windows: copy .env.example .env)
# ----------------------------------------------------------------------------

# REQUIRED — Groq API key. Get one free at https://console.groq.com/keys
GROQ_API_KEY=

# OPTIONAL — Tavily key for higher-quality, full-content web search.
# Get one free at https://app.tavily.com . If left blank, DeepDive automatically
# falls back to keyless DuckDuckGo search (snippets + on-the-fly page fetching).
TAVILY_API_KEY=

# ----------------------------------------------------------------------------
# Optional overrides (sensible defaults are baked into src/deepdive/config.py)
# ----------------------------------------------------------------------------

# Models (IDs live here so a Groq deprecation is a one-line change).
GROQ_REASONING_MODEL=llama-3.3-70b-versatile
GROQ_EXTRACT_MODEL=llama-3.1-8b-instant

# Local embedding model (Groq has no embeddings API). Upgrade option:
#   BAAI/bge-small-en-v1.5  (better retrieval, ~133 MB)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Search backend: auto | tavily | ddg   (auto = Tavily if key present, else DDG)
SEARCH_PROVIDER=auto

LOG_LEVEL=INFO
